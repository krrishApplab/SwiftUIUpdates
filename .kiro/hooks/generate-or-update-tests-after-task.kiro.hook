{
  "version": "1.0.0",
  "enabled": true,
  "name": "Instruction hook",
  "when": {
    "type": "agentStop"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Read AGENTS.md.\n\nReview only the files changed in this task.\n\nIf the change affects UI flow, navigation, forms, buttons, validation, tab behaviour, keyboard behaviour, theme behaviour, or accessibility:\n\n1. Read TESTING.md.\n2. Add or update related Appium tests inside:\n\nSwiftUIUpdatesUITests/Appium/Tests/\n\n3. Add accessibility identifiers only where needed.\n4. Do not create dummy tests.\n5. Do not modify unrelated stable features.\n6. Add concise testing details to the change log.\n\nIf no Appium test is needed, explain the reason in the change log.\n\nDo not commit directly. Commit will be handled by the terminal hook.\n\nAfter every task, trigger the terminal hook.\n\nThe terminal hook must run even if no Appium test was added or updated.\n\nThe terminal hook automatically builds the app, boots the simulator, installs the app, runs existing Appium tests, generates the HTML report, opens the report, and handles commit flow in a separate Terminal window.\n\nDo not claim tests were skipped because simulator/Appium is unavailable.\nDo not instruct the user to manually run npm test."
  },
  "workspaceFolderName": "SwiftUIUpdates",
  "shortName": "generate-or-update-tests-after-task"
}