{
  "version": "1.0.0",
  "enabled": true,
  "name": "Terminal build + Appium + Commit hook",
  "when": {
    "type": "agentStop"
  },
  "then": {
    "type": "runCommand",
    "command": "#!/bin/bash\nset -e\n\nPROJECT_ROOT=\"${KIRO_PROJECT_ROOT:-$(pwd)}\"\nAPP_NAME=\"SwiftUIUpdates\"\nSCHEME=\"SwiftUIUpdates\"\nSIMULATOR=\"iPhone 16\"\n\nBUILD_SCRIPT=\"/tmp/swiftuiupdates_build_appium.sh\"\nCOMMIT_SCRIPT=\"/tmp/swiftuiupdates_commit.sh\"\n\ncat > \"$BUILD_SCRIPT\" <<SCRIPT\n#!/bin/bash\nset -e\n\ncd \"$PROJECT_ROOT\"\n\necho \"=== Project Root ===\"\npwd\n\necho ''\necho '=== Building app for simulator ==='\nxcodebuild build \\\\\n  -scheme \"$SCHEME\" \\\\\n  -project \"$APP_NAME.xcodeproj\" \\\\\n  -destination \"platform=iOS Simulator,name=$SIMULATOR\"\n\necho ''\necho '=== Booting simulator if needed ==='\nxcrun simctl boot \"$SIMULATOR\" || true\n\nAPP_PATH=\\$(find ~/Library/Developer/Xcode/DerivedData -path \"*/Build/Products/Debug-iphonesimulator/$APP_NAME.app\" -not -path \"*Index.noindex*\" | head -1)\n\nif [ -z \"\\$APP_PATH\" ]; then\n  echo 'App not found after build.'\n  exit 1\nfi\n\necho ''\necho \"=== Installing app from: \\$APP_PATH ===\"\nxcrun simctl install booted \"\\$APP_PATH\"\n\nif [ -d \"SwiftUIUpdatesUITests/Appium\" ]; then\n  cd SwiftUIUpdatesUITests/Appium\n\n  if [ -f \"package.json\" ]; then\n    if [ ! -d \"node_modules\" ]; then\n      echo ''\n      echo '=== Installing Appium dependencies ==='\n      npm install\n    fi\n\n    echo ''\n    echo '=== Running Appium tests ==='\n    npm test || TEST_FAILED=true\n\n    REPORT_PATH=\"\\$(pwd)/Reports/appium-report.html\"\n\n    echo ''\n    echo 'Appium HTML report generated at:'\n    echo \"\\$REPORT_PATH\"\n\n    if [ -f \"\\$REPORT_PATH\" ]; then\n      echo ''\n      echo 'Opening Appium HTML report in browser...'\n      open -a \"Google Chrome\" \"\\$REPORT_PATH\" || open \"\\$REPORT_PATH\"\n    else\n      echo 'Report file not found.'\n    fi\n\n    if [ \"\\$TEST_FAILED\" = true ]; then\n      echo ''\n      echo 'Appium tests failed. Review the HTML report.'\n    fi\n  else\n    echo 'package.json not found. Skipping Appium tests.'\n  fi\nelse\n  echo 'SwiftUIUpdatesUITests/Appium folder not found. Skipping Appium tests.'\nfi\n\necho ''\necho 'Build and Appium flow completed.'\necho 'Commit will continue in a separate Terminal window.'\nread -p 'Press Enter to close this window...'\nSCRIPT\n\ncat > \"$COMMIT_SCRIPT\" <<SCRIPT\n#!/bin/bash\nset -e\n\ncd \"$PROJECT_ROOT\"\n\necho \"=== Project Root ===\"\npwd\n\necho ''\necho '=== Git Status ==='\ngit status\n\necho ''\nread -p 'Enter commit message: ' COMMIT_MSG\n\nif [ -z \"\\$COMMIT_MSG\" ]; then\n  echo 'Commit cancelled. Empty commit message.'\n  exit 1\nfi\n\necho ''\necho '=== Committing changes ==='\ngit add .\ngit commit -m \"\\$COMMIT_MSG\"\n\necho ''\necho '=== Latest Commit ==='\ngit log --oneline -1\n\necho ''\ngit status\n\necho ''\necho 'Commit completed. Press Enter to close...'\nread\nSCRIPT\n\nchmod +x \"$BUILD_SCRIPT\"\nchmod +x \"$COMMIT_SCRIPT\"\n\nosascript <<EOF\ntell application \"Terminal\"\n    activate\n    do script \"bash '$BUILD_SCRIPT'\"\n    do script \"bash '$COMMIT_SCRIPT'\"\nend tell\nEOF"
  },
  "workspaceFolderName": "SwiftUIUpdates",
  "shortName": "terminal-popup-hook"
}