{
  "version": "1.0.0",
  "enabled": true,
  "name": "Run Appium and open HTML report",
  "when": {
    "type": "agentStop"
  },
  "then": {
    "type": "runCommand",
    "command": "#!/bin/bash\nset -e\n\nAPP_NAME=\"SwiftUIUpdates\"\nSCHEME=\"SwiftUIUpdates\"\nSIMULATOR=\"iPhone 16\"\n\necho \"Building app for simulator...\"\nxcodebuild build \\\n  -scheme \"$SCHEME\" \\\n  -project \"${APP_NAME}.xcodeproj\" \\\n  -destination \"platform=iOS Simulator,name=${SIMULATOR}\"\n\necho \"Booting simulator if needed...\"\nxcrun simctl boot \"$SIMULATOR\" || true\n\nAPP_PATH=$(find ~/Library/Developer/Xcode/DerivedData -path \"*/Build/Products/Debug-iphonesimulator/${APP_NAME}.app\" -not -path \"*Index.noindex*\" | head -1)\n\nif [ -z \"$APP_PATH\" ]; then\n  echo \"App not found after build.\"\n  exit 1\nfi\n\necho \"Installing app from: $APP_PATH\"\nxcrun simctl install booted \"$APP_PATH\"\n\nif [ -d \"SwiftUIUpdatesUITests/Appium\" ]; then\n  cd SwiftUIUpdatesUITests/Appium\n  if [ -f \"package.json\" ]; then\n    if [ ! -d \"node_modules\" ]; then\n      echo \"Installing Appium dependencies...\"\n      npm install\n    fi\n    echo \"Running Appium tests...\"\n    npm test\n    REPORT_PATH=\"$(pwd)/Reports/appium-report.html\"\n    echo \"\"\n    echo \"Appium HTML report generated at:\"\n    echo \"$REPORT_PATH\"\n    if [ -f \"$REPORT_PATH\" ]; then\n      open \"$REPORT_PATH\"\n    else\n      echo \"Report file not found.\"\n    fi\n  else\n    echo \"package.json not found. Skipping Appium tests.\"\n  fi\nelse\n  echo \"SwiftUIUpdatesUITests/Appium folder not found. Skipping Appium tests.\"\nfi\n"
  }
}
